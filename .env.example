# --- API ---
# Solo escucha en loopback. No lo expongas sin poner API_KEY.
HOST=127.0.0.1
PORT=8787
# Opcional: si se define, la API exige el header  x-api-key: <valor>
API_KEY=

# --- Deepgram ---
# Requerida para transcribir audios. Sin ella, los audios se devuelven sin transcript.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# "multi" detecta y mezcla idiomas (es/en). Usa "es" si todo es espanol.
DEEPGRAM_LANGUAGE=multi

# --- Sesion de WhatsApp ---
SESSION_ID=default
# true = pide a WhatsApp el archivo completo al emparejar (lento, mucho volumen).
# false = solo los chats recientes.
REQUIRE_FULL_SYNC=false

# --- Rutas (relativas a la raiz del proyecto) ---
DATA_DIR=data

# --- Credenciales portables (ver "npm run creds:export") ---
# Para reanudar una sesion ya emparejada en OTRO ambiente sin escanear el QR.
# El daemon solo las usa si NO existe data/auth.sqlite; el store local siempre manda.
# Define UNA de las dos:
#   WA_CREDS       el blob base64 en la propia variable
#   WA_CREDS_FILE  la ruta a un archivo que lo contiene (usalo si el blob es grande)
WA_CREDS=
WA_CREDS_FILE=
